FROM node:22-bookworm-slim AS build

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/backend ./packages/backend
COPY packages/config ./packages/config
COPY rd/formulation-lab ./rd/formulation-lab

RUN corepack enable \
  && corepack prepare pnpm@11.5.2 --activate \
  && pnpm --filter @flavoneer/formulation-lab... install --frozen-lockfile

RUN pnpm --filter @flavoneer/formulation-lab build

FROM nginx:alpine AS runtime

ENV NGINX_ENVSUBST_OUTPUT_DIR=/usr/share/nginx/html \
  VITE_CONVEX_URL="" \
  VITE_CONVEX_SITE_URL="" \
  VITE_SITE_URL="" \
  VITE_PUBLIC_POSTHOG_KEY="" \
  VITE_PUBLIC_POSTHOG_HOST=""

COPY rd/formulation-lab/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/rd/formulation-lab/dist /usr/share/nginx/html
COPY rd/formulation-lab/public/runtime-config.template.js /etc/nginx/templates/runtime-config.js.template

EXPOSE 80
