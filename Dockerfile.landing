FROM node:22-bookworm-slim AS build

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

ARG NUXT_PUBLIC_LAB_URL
ARG VITE_PUBLIC_POSTHOG_KEY
ARG VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

ENV NUXT_PUBLIC_LAB_URL=$NUXT_PUBLIC_LAB_URL \
  VITE_PUBLIC_POSTHOG_KEY=$VITE_PUBLIC_POSTHOG_KEY \
  VITE_PUBLIC_POSTHOG_HOST=$VITE_PUBLIC_POSTHOG_HOST

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/landing ./apps/landing
COPY packages/config ./packages/config

RUN corepack enable \
  && corepack prepare pnpm@11.5.2 --activate \
  && pnpm --filter @flavoneer/landing... install --frozen-lockfile

RUN pnpm --filter @flavoneer/landing build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
  HOST=0.0.0.0 \
  PORT=3000

WORKDIR /app

COPY --from=build --chown=node:node /app/apps/landing/.output ./.output

USER node

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
