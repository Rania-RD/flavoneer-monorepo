FROM node:22-bookworm-slim AS build

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/backend ./packages/backend
COPY packages/config ./packages/config
COPY apps/qc-floor ./apps/qc-floor

RUN corepack enable \
  && corepack prepare pnpm@11.5.2 --activate \
  && pnpm --filter @flavoneer/qc-floor... install --frozen-lockfile

ARG VITE_CONVEX_URL
ARG VITE_CONVEX_SITE_URL
ARG VITE_FORMULATION_LAB_URL

ENV VITE_CONVEX_URL=$VITE_CONVEX_URL \
  VITE_CONVEX_SITE_URL=$VITE_CONVEX_SITE_URL \
  VITE_FORMULATION_LAB_URL=$VITE_FORMULATION_LAB_URL

RUN test -n "$VITE_CONVEX_URL" \
  && test -n "$VITE_CONVEX_SITE_URL" \
  && pnpm --filter @flavoneer/qc-floor build

FROM nginx:alpine AS runtime

COPY apps/qc-floor/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/qc-floor/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/health || exit 1
