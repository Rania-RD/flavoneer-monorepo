# Optional URL override for the authenticated Flavoneer application.
# Leave empty to use http://localhost:3001 in development and
# https://lab.flavoneer.com in production.
NUXT_PUBLIC_LAB_URL=

# Public PostHog project API key. Analytics remains disabled when this is empty.
VITE_PUBLIC_POSTHOG_KEY=

# PostHog ingestion endpoint. Use https://eu.i.posthog.com for EU-hosted projects.
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
