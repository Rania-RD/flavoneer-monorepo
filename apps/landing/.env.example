# URL of the authenticated Flavoneer application.
NUXT_PUBLIC_LAB_URL=https://lab.flavoneer.com

# Public PostHog project API key. Analytics remains disabled when this is empty.
VITE_PUBLIC_POSTHOG_KEY=

# PostHog ingestion endpoint. Use https://eu.i.posthog.com for EU-hosted projects.
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
