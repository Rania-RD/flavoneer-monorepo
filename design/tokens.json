{
  "$description": "Flavoneer brand tokens. Values match rd/mobile/src/constants/theme.ts and apps/landing/app/assets/css/main.css.",
  "color": {
    "mint": "#D2F2D4",
    "mintSoft": "#E9F8EA",
    "cream": "#FFFDF4",
    "forest": "#1C4A3C",
    "deepForest": "#102F27",
    "ink": "#173E33",
    "inkDeep": "#12382E",
    "copy": "#527568",
    "amber": "#F5A623",
    "amberBright": "#FFB132",
    "amberLight": "#FFC760",
    "orange": "#FF7738",
    "darkCanvas": "#0D2B24",
    "darkSurface": "#173E33",
    "darkSelected": "#285B4D",
    "darkText": "#F7F4DF",
    "darkCopy": "#A9CBBB",
    "success": "#228052"
  },
  "status": {
    "approved": { "background": "#D2F2D4", "text": "#1C4A3C" },
    "pendingReview": { "background": "#FFE3A8", "text": "#6B3F05" },
    "returned": { "background": "#FFD9C5", "text": "#7A2E0B" },
    "draft": { "background": "#F3E7C8", "text": "#4F3A12" }
  },
  "font": {
    "display": { "family": "Fraunces", "weights": [700, 800, 900], "fallback": "Georgia, serif" },
    "text": { "family": "DM Sans", "weights": [400, 500, 600, 700, 800], "fallback": "ui-sans-serif, system-ui, sans-serif" },
    "arabic": { "family": "System Arabic (SF Arabic on iOS, Noto Sans Arabic on Android)" },
    "mono": { "family": "ui-monospace, SF Mono, Menlo, monospace" }
  },
  "radius": { "control": 999, "card": 8, "sheet": 24, "appIcon": "22.37%" },
  "spacing": [2, 4, 8, 16, 24, 32, 64]
}
