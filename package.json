{
  "name": "flavoneer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "11.5.2"
  },
  "scripts": {
    "dev": "pnpm --filter @flavoneer/landing dev",
    "dev:backend": "pnpm --filter @flavoneer/backend dev",
    "dev:landing": "pnpm --filter @flavoneer/landing dev",
    "dev:lab": "pnpm --filter @flavoneer/formulation-lab dev",
    "dev:qc-floor": "pnpm --filter @flavoneer/qc-floor dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:all": "pnpm --parallel --filter @flavoneer/backend --filter @flavoneer/landing --filter @flavoneer/formulation-lab dev",
    "deploy:staging": "pnpm --filter @flavoneer/backend deploy:staging",
    "build": "pnpm -r build",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "validate:convex-targets": "node scripts/validate-convex-targets.mjs",
    "validate:convex-targets:local": "node scripts/validate-convex-targets.mjs --require-local"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@expo/config-plugins": "~57.0.6"
  }
}
