# Convex CLI target for the self-hosted production deployment.
CONVEX_SELF_HOSTED_URL=https://backend.prod.convex.flavoneer.com/
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Deployment origin inventory. The dashboard value is documentation/validation
# metadata; the Convex CLI authenticates with the URL and admin key above.
CONVEX_SITE_URL=https://site.prod.convex.flavoneer.com/
BETTER_AUTH_URL=https://site.prod.convex.flavoneer.com/
CONVEX_SELF_HOSTED_DASHBOARD_URL=https://dashboard.prod.convex.flavoneer.com/
