{
  "name": "@flavoneer/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./data-model": {
      "types": "./convex/_generated/dataModel.d.ts"
    },
    "./ingredient-dependencies": "./lib/ingredients/dependencies.ts",
    "./regulatory": "./convex/regulatoryHelpers.ts",
    "./system-role-access": "./lib/system-role-access.ts",
    "./production-line": "./convex/productionLineRecordHelpers.ts",
    "./lab-samples": "./convex/labSampleHelpers.ts",
    "./units": "./convex/units.ts"
  },
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "deploy:staging": "convex deploy --env-file .env.staging",
    "codegen": "convex codegen",
    "test": "vitest run",
    "typecheck": "tsc -p convex/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "1.5.6",
    "@convex-dev/better-auth": "^0.11.5",
    "@convex-dev/migrations": "0.3.4",
    "@flavoneer/config": "workspace:*",
    "@hot-updater/js": "0.35.4",
    "better-auth": "1.5.6",
    "convex": "^1.41.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.14.0",
    "convex-test": "^0.0.54",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
