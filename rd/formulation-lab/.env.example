# Convex deployment endpoints.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Public application URL used for browser redirects.
VITE_SITE_URL=http://localhost:3001

# Public PostHog project API key. Analytics remains disabled when this is empty.
VITE_PUBLIC_POSTHOG_KEY=

# PostHog ingestion endpoint. Use https://eu.i.posthog.com for EU-hosted projects.
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
