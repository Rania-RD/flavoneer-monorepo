# Convex deployment endpoints.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Public application URL used for browser redirects.
VITE_SITE_URL=http://localhost:3001

# PostHog browser analytics. These public Vite variables must be available at build time.
# Use the same project token as the landing deployment for cross-surface journey analysis.
# Leave the project token empty to disable analytics safely in local development.
VITE_PUBLIC_POSTHOG_KEY=

# US Cloud ingestion endpoint. Use https://eu.i.posthog.com for EU Cloud.
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
